{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Vault Genome: one EC2 instance on AMD SEV-SNP (shared tenancy; m6a, c6a or r6a) that stands itself up from the signed release, proves the deployment and keeps running. Generated by deploy/aws/make-template.sh from deploy/aws/guest.sh; do not edit by hand.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "The instance"
          },
          "Parameters": [
            "InstanceName",
            "InstanceType",
            "AmiId",
            "VpcId",
            "SubnetId"
          ]
        },
        {
          "Label": {
            "default": "Access"
          },
          "Parameters": [
            "SshPublicKey",
            "SshSourceCidr"
          ]
        },
        {
          "Label": {
            "default": "The release"
          },
          "Parameters": [
            "Release",
            "ChecksumsSha256",
            "Stamp"
          ]
        }
      ]
    }
  },
  "Parameters": {
    "InstanceName": {
      "Type": "String",
      "Default": "vaultgenome",
      "MinLength": 1,
      "MaxLength": 40,
      "AllowedPattern": "^[A-Za-z][A-Za-z0-9-]*$",
      "Description": "The instance's name; every resource carries it."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "m6a.xlarge",
      "AllowedValues": [
        "m6a.large",
        "m6a.xlarge",
        "m6a.2xlarge",
        "m6a.4xlarge",
        "m6a.8xlarge",
        "c6a.large",
        "c6a.xlarge",
        "c6a.2xlarge",
        "c6a.4xlarge",
        "c6a.8xlarge",
        "c6a.12xlarge",
        "c6a.16xlarge",
        "r6a.large",
        "r6a.xlarge",
        "r6a.2xlarge",
        "r6a.4xlarge"
      ],
      "Description": "An instance type with AMD SEV-SNP (AMD Milan): m6a, c6a or r6a, in US East (Ohio) or Europe (Ireland). The launch measurement depends on the vCPU count."
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
      "Description": "Canonical's current Ubuntu 24.04 AMI for the region (UEFI boot, configfs-tsm in the kernel), read from AWS's public SSM parameter."
    },
    "VpcId": {
      "Type": "String",
      "Default": "",
      "Description": "Empty: the default VPC. Else the VPC of the subnet below."
    },
    "SubnetId": {
      "Type": "String",
      "Default": "",
      "Description": "Empty: a default subnet of the default VPC. Else a public subnet (the guest fetches the release from GitHub and the chain from AMD KDS, and is reached over ssh)."
    },
    "SshPublicKey": {
      "Type": "String",
      "MinLength": 1,
      "AllowedPattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256) [A-Za-z0-9+/=]+( .*)?$",
      "Description": "The ssh public key of the person deploying (one line, ssh-ed25519 or ssh-rsa). The user is ubuntu (sudo). The daemons run as root services; the record is readable by this user."
    },
    "SshSourceCidr": {
      "Type": "String",
      "Default": "0.0.0.0/0",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$",
      "Description": "Who may reach port 22: your address as a.b.c.d/32, or 0.0.0.0/0 for anyone with the key. The Vault Genome listeners bind loopback only."
    },
    "Release": {
      "Type": "String",
      "Default": "v0.14.0",
      "AllowedPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-rc[0-9]+)?$",
      "Description": "The signed release to deploy (a tag). The guest verifies its checksums list under the release workflow's identity for this tag before it runs anything."
    },
    "ChecksumsSha256": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^([0-9a-f]{64})?$",
      "Description": "Set by deploy.sh: the SHA-256 of the checksums list it verified; the guest refuses a different list."
    },
    "Stamp": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^([0-9]{8}T[0-9]{6}Z)?$",
      "Description": "Names the record (UTC, yyyymmddThhmmssZ); set by deploy.sh. Empty: the guest stamps it."
    }
  },
  "Conditions": {
    "HasVpc": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "VpcId"
            },
            ""
          ]
        }
      ]
    },
    "HasSubnet": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "SubnetId"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "KeyPair": {
      "Type": "AWS::EC2::KeyPair",
      "Properties": {
        "KeyName": {
          "Fn::Sub": "vg-${AWS::StackName}"
        },
        "PublicKeyMaterial": {
          "Ref": "SshPublicKey"
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "vaultgenome"
          },
          {
            "Key": "vg-name",
            "Value": {
              "Ref": "InstanceName"
            }
          },
          {
            "Key": "vg-tag",
            "Value": {
              "Ref": "Release"
            }
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Vault Genome: ssh from the deployer; the daemons listen on loopback only",
        "VpcId": {
          "Fn::If": [
            "HasVpc",
            {
              "Ref": "VpcId"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "SshSourceCidr"
            },
            "Description": "ssh"
          }
        ],
        "Tags": [
          {
            "Key": "app",
            "Value": "vaultgenome"
          },
          {
            "Key": "vg-name",
            "Value": {
              "Ref": "InstanceName"
            }
          },
          {
            "Key": "vg-tag",
            "Value": {
              "Ref": "Release"
            }
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": {
          "Fn::Sub": "vg-${AWS::StackName}-sev-snp"
        },
        "LaunchTemplateData": {
          "CpuOptions": {
            "AmdSevSnp": "enabled"
          },
          "MetadataOptions": {
            "HttpEndpoint": "enabled",
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 1,
            "InstanceMetadataTags": "enabled"
          },
          "UserData": "",
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/sda1",
              "Ebs": {
                "VolumeSize": 32,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "TagSpecifications": [
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "app",
                  "Value": "vaultgenome"
                },
                {
                  "Key": "vg-name",
                  "Value": {
                    "Ref": "InstanceName"
                  }
                },
                {
                  "Key": "vg-tag",
                  "Value": {
                    "Ref": "Release"
                  }
                },
                {
                  "Key": "Name",
                  "Value": {
                    "Fn::Sub": "${InstanceName}-osdisk"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "KeyName": {
          "Ref": "KeyPair"
        },
        "SecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "SecurityGroup",
              "GroupId"
            ]
          }
        ],
        "SubnetId": {
          "Fn::If": [
            "HasSubnet",
            {
              "Ref": "SubnetId"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "vaultgenome"
          },
          {
            "Key": "vg-name",
            "Value": {
              "Ref": "InstanceName"
            }
          },
          {
            "Key": "vg-tag",
            "Value": {
              "Ref": "Release"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "InstanceName"
            }
          },
          {
            "Key": "vg-stamp",
            "Value": {
              "Ref": "Stamp"
            }
          },
          {
            "Key": "vg-sealer",
            "Value": "auto"
          },
          {
            "Key": "vg-checksums-sha256",
            "Value": {
              "Ref": "ChecksumsSha256"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Instance",
          "PublicIp"
        ]
      }
    },
    "SshCommand": {
      "Value": {
        "Fn::Sub": "ssh ubuntu@${Instance.PublicIp}"
      }
    },
    "ConsoleCommand": {
      "Value": {
        "Fn::Sub": "aws ec2 get-console-output --region ${AWS::Region} --instance-id ${Instance} --latest --output text"
      }
    },
    "Stamp": {
      "Value": {
        "Ref": "Stamp"
      }
    }
  }
}
