# Go build output
/bin/
/dist/
# `go build ./cmd/<name>` from the module root drops the binary here.
/sagvd
/acp-compute
/acp-bootstrap
/acp-demo
/acpctl
/acp-keygen
*.exe
*.test
*.out
# a hardware kit's record of what the person saw (guest.out, provision.out) is evidence, not build output
!scripts/hardware-test/**/evidence/**/*.out
*.prof
*.trace

# Coverage artifacts
coverage.out
coverage.html
coverage.txt

# SBOMs and attestations (generated by CI, never committed)
*.sbom.json
*.sbom.spdx.json
*.sig
# the vTPM quote signatures in the hardware kits' records are evidence, not CI output
!scripts/hardware-test/**/evidence/**/*.sig
*.cert
*.intoto.jsonl

# Local env and secrets (NEVER commit)
.env
.env.*
!.env.example
*.key
*.pem
# The synthetic root of the acpctl attest-nitro fixture is a test certificate, not a key.
!cmd/acpctl/testdata/nitro/synthetic-root.pem
!docs/**/*.pem.example
# public AMD KDS certificate chains captured as hardware attestation evidence
# (X.509 certs, not keys) — needed by the SEV-SNP verification tests.
!scripts/hardware-test/**/*.pem
!test/corpus/sev-snp/chains/*.pem
# The CMS vectors' throwaway RSA-3072 key and its self-signed certificate,
# made by make-vectors.sh beside them for those vectors only (ADR 0036,
# part three; the key is allowlisted for gitleaks by path).
!internal/shared/cms/testdata/*.pem
# Amazon Trust Services' four public root certificates, which the KMS
# client embeds to verify KMS (ADR 0036, part three): certificates, not keys.
!internal/shared/awskms/roots/*.pem
# The EC2 SEV-SNP capture of ADR 0038: the host's VLEK, AMD's VLEK and VCEK
# chains from KDS and the ASVK/ARK as snpguest wrote them — certificates, not
# keys; the family's fixture and the corpus's source of VLEK-signed reports.
!internal/shared/tee/testdata/aws-sev-snp/**/*.pem

# Key material provisioned by deploy/compose/keygen (NEVER commit)
/deploy/compose/secrets/

# Local vault state (operational artifacts, not source)
/var/
/data/
*.bolt
*.db
*.wal
# ...except a drill's audit log, kept as evidence so it can be verified offline
!scripts/hardware-test/**/evidence/**/xcc-audit.db

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Go module cache symlinks (per-developer)
/vendor/

# Terraform / infra state (if/when added)
*.tfstate
*.tfstate.backup
.terraform/

# --- honest-reference build snapshot ignores ---
**/.terraform/
*.tfstate
*.tfstate.*
**/main.tf.bak

# Python worker caches
__pycache__/
.pytest_cache/

# Compose demo: sealed genomes with their key files, and the base model.
deploy/compose/genomes/
deploy/compose/models/
deploy/compose/audit/

# The Python distribution's build output (pyproject.toml at the root)
/build/
*.egg-info/

# the one-button deployment on Google Cloud: its fetched tools and a person's own records
/deploy/gcp/.tools/
/deploy/gcp/records/

# the one-button deployment on Azure: its fetched tools and a person's own records
/deploy/azure/.tools/
/deploy/azure/records/
