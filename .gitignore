# Go build output
/bin/
/dist/
*.exe
*.test
*.out
*.prof
*.trace

# Coverage artifacts
coverage.out
coverage.html
coverage.txt

# SBOMs and attestations (generated by CI, never committed)
*.sbom.json
*.sbom.spdx.json
*.sig
*.cert
*.intoto.jsonl

# Local env and secrets (NEVER commit)
.env
.env.*
!.env.example
*.key
*.pem
!docs/**/*.pem.example
# public AMD KDS certificate chains captured as hardware attestation evidence
# (X.509 certs, not keys) — needed by the SEV-SNP verification tests.
!scripts/hardware-test/**/*.pem

# Key material provisioned by deploy/compose/keygen (NEVER commit)
/deploy/compose/secrets/

# Local vault state (operational artifacts, not source)
/var/
/data/
*.bolt
*.db
*.wal

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Go module cache symlinks (per-developer)
/vendor/

# Terraform / infra state (if/when added)
*.tfstate
*.tfstate.backup
.terraform/

# --- honest-reference build snapshot ignores ---
**/.terraform/
*.tfstate
*.tfstate.*
**/main.tf.bak
