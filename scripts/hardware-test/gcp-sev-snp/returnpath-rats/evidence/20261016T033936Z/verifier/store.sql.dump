CREATE TABLE IF NOT EXISTS "module_tags" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "tag_id_type" VARCHAR, "tag_id" VARCHAR, "tag_version" INTEGER, "language" VARCHAR, "manifest_id" INTEGER);
