CREATE TABLE IF NOT EXISTS "manifests" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "manifest_id_type" VARCHAR, "manifest_id" VARCHAR, "digest" BLOB, "time_added" TIMESTAMP, "label" VARCHAR, "profile_type" VARCHAR, "profile" VARCHAR, "not_before" TIMESTAMP, "not_after" TIMESTAMP);
