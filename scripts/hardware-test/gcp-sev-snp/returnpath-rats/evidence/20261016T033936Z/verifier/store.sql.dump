CREATE TABLE IF NOT EXISTS "roles" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "role" VARCHAR, "entity_id" INTEGER);
CREATE TABLE IF NOT EXISTS "linked_tags" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "linked_tag_id_type" VARCHAR, "linked_tag_id" VARCHAR, "tag_relation" VARCHAR, "module_id" INTEGER);
CREATE TABLE IF NOT EXISTS "value_triples" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "environment_id" INTEGER, "type" VARCHAR, "is_active" BOOLEAN, "module_id" INTEGER);
