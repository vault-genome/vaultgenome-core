CREATE TABLE IF NOT EXISTS "extensions" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "field_kind" INTEGER, "field_name" VARCHAR, "json_tag" VARCHAR, "cbor_tag" VARCHAR, "value_bytes" BLOB, "value_text" VARCHAR, "value_int" INTEGER, "value_float" DOUBLE PRECISION, "owner_id" INTEGER, "owner_type" VARCHAR);
