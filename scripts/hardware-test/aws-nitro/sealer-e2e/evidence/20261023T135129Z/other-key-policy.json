{
  "Version": "2012-10-17",
  "Id": "vaultgenome-nitro-sealer-run",
  "Statement": [
    {
      "Sid": "TheAccountAdministersOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:EnableKey",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TheKitAdministers",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-kit"
      },
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:ListResourceTags",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TheOperatorSeals",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-kit"
      },
      "Action": "kms:GenerateDataKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:vault-genome:sealed-secret": "v1"
        }
      }
    },
    {
      "Sid": "NoDecryptWithoutAnEnclave",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "Null": {
          "kms:RecipientAttestation:ImageSha384": "true"
        }
      }
    },
    {
      "Sid": "OnlyTheImageOpens",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-parent"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:ImageSha384": "1ea32e108bb4a314a4946b94cbf02d0eb83a791b0f3eafeb4daea3b0999eeb2451db3c3580bb74102b00f297d7524c90"
        },
        "StringEquals": {
          "kms:EncryptionContext:vault-genome:pcr0": "1ea32e108bb4a314a4946b94cbf02d0eb83a791b0f3eafeb4daea3b0999eeb2451db3c3580bb74102b00f297d7524c90"
        }
      }
    }
  ]
}
