{
  "Version": "2012-10-17",
  "Id": "vaultgenome-nitro-crosscloud-run",
  "Statement": [
    {
      "Sid": "TheAccountAdministersOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:root"
      },
      "Action": [
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:EnableKey",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TheKitAdministers",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-kit"
      },
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:ListResourceTags",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TheOperatorSeals",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-kit"
      },
      "Action": "kms:GenerateDataKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:vault-genome:sealed-secret": "v1"
        }
      }
    },
    {
      "Sid": "NoDecryptWithoutAnEnclave",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "Null": {
          "kms:RecipientAttestation:ImageSha384": "true"
        }
      }
    },
    {
      "Sid": "OnlyTheImageOpens",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<account>:role/vaultgenome-nitro-parent"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:ImageSha384": "e80a10e420023f1d32198e5d9a130c0017f106da1545e9d3e4488c9d57f1582db723803d810160e7f5e1a943aecf5219"
        },
        "StringEquals": {
          "kms:EncryptionContext:vault-genome:pcr0": "e80a10e420023f1d32198e5d9a130c0017f106da1545e9d3e4488c9d57f1582db723803d810160e7f5e1a943aecf5219"
        }
      }
    }
  ]
}