[Unit]
Description=Vault Genome worker (acp-compute), release v0.14.0
Documentation=https://github.com/vault-genome/vaultgenome-core/blob/v0.14.0/docs/operator/00_overview.md
After=network-online.target sagvd.service
Wants=network-online.target sagvd.service

[Service]
ExecStart=/opt/vaultgenome/bin/acp-compute -config /etc/vaultgenome/acp-compute.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultgenome /etc/vaultgenome

[Install]
WantedBy=multi-user.target
