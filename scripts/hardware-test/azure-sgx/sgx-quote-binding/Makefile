# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Makefile — Vault Genome SGX quote-binding (Open Enclave 0.19+, gcc).
#
# Builds two artifacts:
#   binding_host          — host program; reads report-data.bin (64 bytes),
#                           creates the enclave, calls the ECALL, writes
#                           out the OE-wrapped report and the raw SGX quote.
#   binding_enc.signed    — signed enclave (oesign output).
#
# Usage on the SGX VM:
#   sudo apt-get install -y -qq pkg-config build-essential
#   make
#   ./binding_host binding_enc.signed report-data.bin quote.bin
#
# OE 0.19 ships with /opt/openenclave/share/openenclave/config/openenclaverc
# which adds /opt/openenclave/bin to PATH (oeedger8r, oesign).

SHELL := /bin/bash

# Source openenclaverc if it exists — adds OE bin dir to PATH.
OE_ROOT     ?= /opt/openenclave
OE_PKGCONFIG = $(OE_ROOT)/share/pkgconfig
PATH        := $(OE_ROOT)/bin:$(PATH)

# Pick gcc by default; OE samples support both gcc and clang.
C_COMPILER ?= gcc

ENCLAVE_OBJ      = binding_enc
SIGNED_ENCLAVE   = binding_enc.signed
HOST_OBJ         = binding_host
VERIFY_OBJ       = verify_quote
ENCLAVE_KEY      = enc/private.pem
ENCLAVE_PUBKEY   = enc/public.pem

# Generated by oeedger8r from binding.edl
ENCLAVE_GEN_C    = enc/binding_t.c
ENCLAVE_GEN_H    = enc/binding_t.h
HOST_GEN_C       = host/binding_u.c
HOST_GEN_H       = host/binding_u.h

# Use pkg-config to pick up correct flags from the OE install.
PKG_CONFIG_PATH := $(OE_PKGCONFIG)
export PKG_CONFIG_PATH

ENCLAVE_CFLAGS  = $(shell pkg-config oeenclave-$(C_COMPILER) --cflags) -O2 -Wall

# OE 0.19's oeenclave-gcc.pc returns only the bare-minimum libs
# (-loeenclave -loelibc -loesyscall -loecore). oe_get_report() pulls
# in cert/crypto/mbedtls internally, so we extend the link line with
# the mbedtls flavor explicitly. The flavour suffix order matters:
# -loeenclave first, then crypto+mbedtls, then libc/syscall/core last.
OE_LIBDIR        = $(OE_ROOT)/lib/openenclave/enclave
ENCLAVE_LDFLAGS  = -nostdlib -nodefaultlibs -nostartfiles \
                   -Wl,--no-undefined -Wl,-Bstatic -Wl,-Bsymbolic \
                   -Wl,--export-dynamic -Wl,-pie -Wl,--build-id \
                   -Wl,-z,noexecstack -Wl,-z,now -Wl,-gc-sections \
                   -L$(OE_LIBDIR) \
                   -loeenclave \
                   -loecryptombedtls -lmbedx509 -lmbedtls -lmbedcrypto \
                   -loelibc -loesyscall -loecore

HOST_CFLAGS      = $(shell pkg-config oehost-$(C_COMPILER) --cflags) -O2 -Wall
HOST_LDFLAGS     = $(shell pkg-config oehost-$(C_COMPILER) --libs)

.PHONY: all clean

all: $(SIGNED_ENCLAVE) $(HOST_OBJ) $(VERIFY_OBJ)

# ----- generate marshalling stubs from EDL -----
$(ENCLAVE_GEN_C) $(ENCLAVE_GEN_H): binding.edl
	@mkdir -p enc
	oeedger8r --trusted binding.edl --search-path $(OE_ROOT)/include \
		--trusted-dir enc

$(HOST_GEN_C) $(HOST_GEN_H): binding.edl
	@mkdir -p host
	oeedger8r --untrusted binding.edl --search-path $(OE_ROOT)/include \
		--untrusted-dir host

# ----- enclave -----
$(ENCLAVE_OBJ): enc/enc.c $(ENCLAVE_GEN_C) $(ENCLAVE_GEN_H)
	$(C_COMPILER) -o $@ enc/enc.c $(ENCLAVE_GEN_C) \
		$(ENCLAVE_CFLAGS) -Ienc $(ENCLAVE_LDFLAGS)

$(ENCLAVE_KEY):
	@mkdir -p enc
	openssl genrsa -out $@ -3 3072

$(ENCLAVE_PUBKEY): $(ENCLAVE_KEY)
	openssl rsa -in $(ENCLAVE_KEY) -pubout -out $@

$(SIGNED_ENCLAVE): $(ENCLAVE_OBJ) enc/enc.conf $(ENCLAVE_KEY)
	oesign sign -e $(ENCLAVE_OBJ) -c enc/enc.conf -k $(ENCLAVE_KEY)

# ----- host -----
$(HOST_OBJ): host/host.c $(HOST_GEN_C) $(HOST_GEN_H)
	$(C_COMPILER) -o $@ host/host.c $(HOST_GEN_C) \
		$(HOST_CFLAGS) -Ihost $(HOST_LDFLAGS)

# ----- standalone Intel DCAP chain verifier -----
# Links against:
#   libsgx_dcap_quoteverify  (Intel chain validator)
#   libsgx_urts              (untrusted runtime, pulled in by linker)
# Headers come from libsgx-dcap-ql-dev and libsgx-dcap-quote-verify-dev,
# which 01-bootstrap-vm.sh installs alongside the runtime libs.
$(VERIFY_OBJ): host/verify-quote.c
	$(C_COMPILER) -O2 -Wall -o $@ host/verify-quote.c \
		-lsgx_dcap_quoteverify -lpthread

clean:
	rm -f $(ENCLAVE_OBJ) $(SIGNED_ENCLAVE) $(HOST_OBJ) $(VERIFY_OBJ) \
		$(ENCLAVE_GEN_C) $(ENCLAVE_GEN_H) $(HOST_GEN_C) $(HOST_GEN_H) \
		$(ENCLAVE_KEY) $(ENCLAVE_PUBKEY) \
		enc/binding_args.h host/binding_args.h
