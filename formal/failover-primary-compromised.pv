(* The primary itself is the attacker's: the seed and the chip's quotes at its measurement
   Generated by gen.py; do not edit by hand. ProVerif 2.05 syntax.
   Copyright (C) 2026 Serhii Nikolaichuk, Rodion Sorokin
   SPDX-License-Identifier: AGPL-3.0-or-later *)

free c: channel.

type skey.
type pkey.
fun pk(skey): pkey.
fun pk2b(pkey): bitstring [data].

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksig(sign(m, k), pk(k)) = m.

fun h(bitstring): bitstring.

const m_P: bitstring.          (* the primary's measurement, pinned by the policy *)
const m_SB: bitstring.         (* the standby's measurement, named by the policy *)
const meas_bad: bitstring.     (* a genuine chip the policy does not name *)
const g0: bitstring.           (* generations *)
const g1: bitstring.
const serial1: bitstring.      (* the policy serial *)
const POLICY: bitstring.
const SEAL: bitstring.
const CR: bitstring.
const label_rec: bitstring.    (* the chip's challenge over a sentinel record (ADR 0017) *)
const label_bind: bitstring.   (* "vault-genome xcc-kem-bind v2" *)
const label_rcpt: bitstring.   (* "vault-genome restore-receipt v1" *)
const suite_strong: bitstring.
const kid1: bitstring.
const kind: bitstring.
const s0: bitstring.
const s1: bitstring.
const nostop: bitstring.
const stopall: bitstring.
const ph0: bitstring.
const ph1: bitstring.

(* HPKE in base mode with additional data (the escrow and the release). *)
fun hpke(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, k: skey, a: bitstring; hpke_open(hpke(m, pk(k), a), k, a) = m.

free tk: skey [private].       (* the chips' attestation key *)
free skO: skey [private].      (* the operator's key: the policy and the stop list *)
free skSent: skey [private].   (* the sentinel's signing key *)
free skEsc: skey [private].    (* the authority's escrow key *)
free skS: skey [private].      (* the authority's signing key: the release *)
free kg: bitstring [private].  (* the genome key of generation g1 *)
free bundle: bitstring.        (* the sealed bundle: ciphertext, public *)


event PolicyIssued(bitstring).
event PolicyNames(bitstring, bitstring).
event SentinelSealed(bitstring).
event SentinelReported(bitstring).
event Decided(bitstring, bitstring).
event Chosen(bitstring).
event Released(bitstring, bitstring).
event Opened(bitstring, bitstring).
event AuthorizedIn(bitstring).

query attacker(kg).
query ser: bitstring, g: bitstring; event(Decided(ser, g)) ==> event(PolicyIssued(ser)).
query ser: bitstring, m: bitstring; event(Released(ser, m)) ==> event(PolicyNames(ser, m)).
query ser: bitstring, g: bitstring; event(Decided(ser, g)) ==> event(SentinelReported(g)).
query g: bitstring; event(Chosen(g)) ==> event(SentinelSealed(g)).
query ser: bitstring, k: bitstring, g: bitstring; event(Opened(ser, k)) ==> event(Decided(ser, g)).
query event(AuthorizedIn(ph1)).

(* The operator: the policy, and the stop lists. *)
let Operator =
  event PolicyIssued(serial1);
  event PolicyNames(serial1, m_SB);
  out(c, sign((POLICY, serial1, pk2b(pk(skSent)), m_P, m_SB), skO)).

(* The sentinel on the primary: one generation sealed, then the compromise report. The report
   carries the standby it would like, which the executor ignores (the policy names it). *)
let Sentinel =
  let env = hpke(kg, pk(skEsc), g1) in
  let rec = (SEAL, g1, h(bundle), env, g0) in
  event SentinelSealed(g1);
  out(c, (rec, sign(rec, skSent), sign((m_P, h((label_rec, rec))), tk)));
  let cr = (CR, g1, m_SB) in
  event SentinelReported(g1);
  out(c, (cr, sign(cr, skSent), sign((m_P, h((label_rec, cr))), tk))).

(* The executor on the authority: the policy, the trigger, the genome, the decision, the release. *)
let Executor(ser_stop: bitstring, ph: bitstring) =
  in(c, pol: bitstring);
  let (=POLICY, serial: bitstring, pks: bitstring, mp: bitstring, msb: bitstring) = checksig(pol, pk(skO)) in
  let pk2b(pkSent) = pks in
  in(c, (cr: bitstring, scr: bitstring, qcr: bitstring));
  if checksig(scr, pkSent) = cr then
  let (mq: bitstring, rq: bitstring) = checksig(qcr, pk(tk)) in
  if mq = mp then
  if rq = h((label_rec, cr)) then
  let (=CR, glast: bitstring, dsb: bitstring) = cr in
  in(c, (rec: bitstring, srec: bitstring, qrec: bitstring));
  if checksig(srec, pkSent) = rec then
  let (mq2: bitstring, rq2: bitstring) = checksig(qrec, pk(tk)) in
  if mq2 = mp then
  if rq2 = h((label_rec, rec)) then
  let (=SEAL, g: bitstring, bh: bitstring, env: bitstring, parent: bitstring) = rec in
  if g = glast then
  if bh = h(bundle) then
  event Decided(serial, g);
  event Chosen(g);
  let dek = hpke_open(env, skEsc, g) in
  (* the attested release of part one, to the standby of the policy, under the stop list *)
  new reqid: bitstring; new decid: bitstring; new n: bitstring;
  out(c, sign((reqid, decid, n, kind), skS));
  in(c, (suite: bitstring, pkb: bitstring, ev: bitstring));
  let pk2b(pkh) = pkb in
  let (m: bitstring, rd: bitstring) = checksig(ev, pk(tk)) in
  if rd = h((label_bind, suite, pkb, n)) then
  in(c, sl: bitstring);
  let (sserial: bitstring, flag: bitstring) = checksig(sl, pk(skO)) in
  if sserial = ser_stop then
  if flag = nostop then
  if m = msb then
  new tokenid: bitstring;
  let aad = h((tokenid, m, kid1)) in
  event Released(serial, m);
  event AuthorizedIn(ph);
  out(c, sign((tokenid, decid, reqid, m, kid1, suite, hpke(dek, pkh, aad), aad, serial), skS)).

(* The standby, at the measurement the policy names: the destination of part one. *)
let Standby =
  in(c, req: bitstring);
  let (reqid: bitstring, decid: bitstring, n: bitstring, k: bitstring) = checksig(req, pk(skS)) in
  new hk: skey;
  let pkb = pk2b(pk(hk)) in
  out(c, (suite_strong, pkb, sign((m_SB, h((label_bind, suite_strong, pkb, n))), tk)));
  in(c, tok: bitstring);
  let (tokenid: bitstring, decid2: bitstring, reqid2: bitstring, m: bitstring, kid: bitstring, suite: bitstring, ct: bitstring, aad: bitstring, serial: bitstring) = checksig(tok, pk(skS)) in
  if decid2 = decid then
  if reqid2 = reqid then
  if aad = h((tokenid, m, kid)) then
  if suite = suite_strong then
  let x = hpke_open(ct, hk, aad) in
  event Opened(serial, x).

(* A genuine chip the policy does not name: it quotes over whatever the attacker asks. *)
let Impostor =
  in(c, chal: bitstring);
  out(c, sign((meas_bad, chal), tk)).

(* The primary in the attacker's hands: its chip quotes at the primary's measurement over whatever is asked. *)
let PrimaryChip =
  in(c, chal: bitstring);
  out(c, sign((m_P, chal), tk)).

process
  out(c, pk(tk)); out(c, pk(skO)); out(c, pk(skSent)); out(c, pk(skEsc)); out(c, pk(skS));
  out(c, skSent);
  out(c, sign((s0, nostop), skO));
  ( Operator | Sentinel | !Executor(s0, ph0) | !Standby | !Impostor | !PrimaryChip )
